						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			conn_therm {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "user_space";
				thermal-sensors = <0x0b 0x4f>;
				wake-capable-sensor;

				trips {

					active-config0 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			tspk_therm {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "user_space";
				thermal-sensors = <0x2d 0x54>;
				wake-capable-sensor;

				trips {

					active-config0 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@102 {
		target = <0xffffffff>;

		__overlay__ {

			gpio_keys {
				compatible = "gpio-keys";
				label = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <0x73>;

				vol_up {
					label = "volume_up";
					gpios = <0x33 0x01 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x73>;
					gpio-key,wakeup;
					debounce-interval = <0x0f>;
					linux,can-disable;
				};
			};

			ldo_vib {
				compatible = "moto,vibrator-ldo";
				moto,vib-ldo-gpio = <0xffffffff 0x64 0x00>;
				status = "disabled";
			};

			qcom,tz_gpio {
				compatible = "qcom,tz_gpio";
				tlmm-tz = <0x00 0x0d 0x0e 0x0f 0x10>;
			};

			sys_temp_support {
				mmi,need-uevent-sensors = "back_temp";
				mmi,uevent-temp-threshold = <0x9c40>;
			};
		};
	};

	fragment@103 {
		target = <0xffffffff>;

